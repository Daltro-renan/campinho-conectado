# Copie este arquivo para .env e preencha os valores.

# Conexão com o PostgreSQL (ex.: Neon, Render, Supabase, Railway)
DATABASE_URL=postgres://usuario:senha@host:5432/campinho

# Segredo para assinar os tokens de login. Use um texto longo e aleatório.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo

# Porta do servidor (opcional, padrão 5000)
PORT=5000

# Só para o app nativo (Capacitor): endereço público do servidor.
# Deixe vazio na versão web — o app usa o mesmo domínio.
VITE_API_URL=
